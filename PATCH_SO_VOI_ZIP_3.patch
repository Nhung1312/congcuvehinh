+        Math.max(
+          -1,
+          Math.min(
+            1,
+            ((a.x - v.x) * (b.x - v.x) + (a.y - v.y) * (b.y - v.y)) / d,
+          ),
+        ),
+      ) *
+        180) /
+        Math.PI
