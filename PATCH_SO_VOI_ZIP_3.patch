+    bounds: [number, number][],
+    construct: (p: number[]) => Point2D[];
+  if (t.type === "equilateral" || t.type === "right-isosceles") return;
+  if (t.type === "right") {
+    seed = [0.7];
+    bounds = [[0.08, 10]];
+    construct = (p) => {
+      const pts: Point2D[] = [];
+      pts[apex] = { x: 0, y: 0 };
+      pts[others[0]] = { x: 1, y: 0 };
+      pts[others[1]] = { x: 0, y: p[0] };
+      return pts;
+    };
+  } else if (t.type === "isosceles") {
+    seed = [0.9];
+    bounds = [[0.06, 8]];
+    construct = (p) => {
+      const pts: Point2D[] = [];
+      pts[apex] = { x: 0.5, y: p[0] };
+      pts[others[0]] = { x: 0, y: 0 };
+      pts[others[1]] = { x: 1, y: 0 };
+      return pts;
+    };
+  } else {
+    seed = [0.35, 0.8];
+    bounds = [
+      [-6, 7],
+      [0.04, 8],
+    ];
+    construct = (p) => [
+      { x: 0, y: 0 },
+      { x: 1, y: 0 },
+      { x: p[0], y: p[1] },
+    ];
+  }
